{
  "name": "trading-journal",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "node --import tsx --test tests/calculations.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-trading-journal \"node --import tsx --test tests/firestore.rules.test.ts\"",
    "test:e2e": "playwright test",
    "build:pages": "ng build --configuration production,github-pages"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.5.1",
    "exceljs": "^4.4.0",
    "firebase": "^12.19.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "firebase-tools": "^15.32.1",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
