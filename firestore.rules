rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Temporary restriction: set false AND update access-policy.ts to reopen access.
    function restrictedAccess() { return true; }
    function allowedAccount() {
      return !restrictedAccess() || (
        request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email.lower() in ['dineshmick@gmail.com']
      );
    }
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid && allowedAccount();
    }
    function valid(e, date) {
      return e.keys().hasAll(['date','startingCapital','pnl','notes','tradeCount','revision'])
        && e.keys().hasOnly(['date','startingCapital','pnl','notes','tradeCount','revision'])
        && e.date is string && e.date == date
        && e.date.matches('^(19|20)[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && (e.startingCapital == null || (e.startingCapital is int && e.startingCapital >= 0 && e.startingCapital <= 1000000000000))
        && e.pnl is int && e.pnl >= -1000000000000 && e.pnl <= 1000000000000
        && e.notes is string && e.notes.size() <= 2000
        && (e.tradeCount == null || (e.tradeCount is int && e.tradeCount >= 0 && e.tradeCount <= 100000))
        && e.revision is int && e.revision >= 1;
    }
    match /users/{uid}/entries/{date} {
      allow read: if owner(uid);
      allow create: if owner(uid) && valid(request.resource.data,date) && request.resource.data.revision == 1;
      allow update: if owner(uid) && valid(request.resource.data,date)
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if owner(uid);
    }
  }
}
